# ── Supabase ────────────────────────────────────────────────────────────────
# Project: xwqmfdsfmalxsirojuwi (region eu-west-1)
# The publishable key is safe for the browser. The secret/service-role key must
# only ever be set in server environments and never prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Payments (Flutterwave) ──────────────────────────────────────────────────
# Leave payments disabled until test-mode verification has passed. The platform
# reads payments_mode from platform_settings, not from this file.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Foreign exchange ────────────────────────────────────────────────────────
# Provider endpoint returning daily reference rates. Unset = no conversions are
# offered for currencies without an explicit price or admin override.
FX_PROVIDER_URL=
FX_PROVIDER_API_KEY=
CRON_SECRET=
