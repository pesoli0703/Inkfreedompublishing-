# ── Supabase ────────────────────────────────────────────────────────────────
# Project: xwqmfdsfmalxsirojuwi (region eu-west-1)
# The publishable key is safe for the browser. The secret/service-role key must
# only ever be set in server environments and never prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Payments (Flutterwave, official REST API) ───────────────────────────────
# Server-side only. Never prefix the secret key or the webhook hash with
# NEXT_PUBLIC_. Payments stay off until platform_settings.payments_mode is
# changed from 'disabled' by an administrator.
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
# The secret hash you type into the Flutterwave dashboard (Settings → Webhooks).
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Optional: override the API host (defaults to https://api.flutterwave.com/v3).
FLUTTERWAVE_API_BASE=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Foreign exchange ────────────────────────────────────────────────────────
# Provider endpoint returning daily reference rates.
# Expected shape: { "base": "NGN", "rates": { "USD": 0.00065, "GBP": 0.00052 } }
# Unset = no conversions are offered for currencies without an explicit price or
# admin override. Rates older than seven days are never used silently.
FX_PROVIDER_URL=
FX_PROVIDER_API_KEY=

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Bearer token required by /api/cron/* (FX refresh and payment reconciliation).
CRON_SECRET=
